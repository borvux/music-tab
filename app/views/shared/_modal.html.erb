<div id="<%= modal_id %>"
     data-controller="modal"
     data-action="
      click->modal#closeOnBackdropClick
     "
     class="fixed inset-0 bg-gray-900 bg-opacity-75 z-50 hidden"
     data-modal-target="container"
     aria-labelledby="modal-title-<%= modal_id %>"
     role="dialog"
     aria-modal="true">

  <div class="flex items-center justify-center min-h-screen">
    <div class="relative bg-gray-800 rounded-lg shadow-xl p-6 w-full max-w-md mx-4" role="document">
      <div class="text-center">
        <h3 class="text-lg leading-6 font-medium text-white" id="modal-title-<%= modal_id %>">
          <%= title %>
        </h3>
        <div class="mt-2">
          <p class="text-sm text-gray-400">
            <%= body %>
          </p>
        </div>
      </div>
      <div class="mt-5 sm:mt-6 flex justify-center space-x-4">
        <button type="button"
                data-action="click->modal#close"
                class="<%= no_btn %> inline-flex justify-center rounded-md border border-transparent shadow-sm px-4 py-2 text-base font-medium focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-gray-800 sm:text-sm">
          <%= no %>
        </button>
        <button type="button"
                data-action="click->modal#confirm"
                data-modal-target="confirmButton"
                class="<%= yes_btn %> inline-flex justify-center rounded-md border border-transparent shadow-sm px-4 py-2 text-base font-medium focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-gray-800 sm:text-sm">
          <%= yes %>
        </button>
      </div>
    </div>
  </div>
</div>
