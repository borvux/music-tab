<!DOCTYPE html>
<html>
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <style>
      body {
        background-color: #1a1a1a;
        color: #f8f9fa;
        font-family: Arial, sans-serif;
        margin: 0;
        padding: 20px;
      }
      .container {
        background-color: #212529;
        border-radius: 8px;
        padding: 20px;
        border: 1px solid #495057;
      }
      .footer {
        margin-top: 20px;
        font-size: 12px;
        color: #6c757d;
        text-align: center;
      }
      a {
        color: #0d6efd;
      }
    </style>
  </head>

  <body>
    <div class="container">
      <%= yield %>
    </div>
    <div class="footer">
      <p>&copy; <%= Time.now.year %> Music Tabs. All rights reserved.</p>
    </div>
  </body>
</html>
