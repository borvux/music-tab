<div class="max-w-3xl mx-auto">
  <div class="mb-6">
    <%= render 'tabs/index/search_bar' %>
  </div>

  <div id="tabs-container">
    <%= render 'tabs/index/index_card', tabs: @tabs, aria: { role: "list" } %>
  </div>

  <div class="flex justify-center mt-6" role="navigation" aria-label="Pagination">
    <%= paginate @tabs, remote: true %>
  </div>
</div>

<%= javascript_include_tag 'smooth_search' %>
