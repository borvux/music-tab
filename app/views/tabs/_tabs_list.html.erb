<% tabs.each do |tab| %>
  <%= link_to tab, class: "block bg-gray-800 hover:bg-gray-700 rounded-lg p-4 mb-3 transition duration-150 ease-in-out", aria: { label: "View #{tab.title}" } do %>
    <div class="flex items-center justify-between">
      <h6 class="text-lg font-semibold text-white"><%= tab.title %></h6>
      <svg class="h-6 w-6 text-sky-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
      </svg>
    </div>
  <% end %>
<% end %>
