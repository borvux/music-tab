<div class="bg-gray-800 shadow-lg rounded-lg overflow-hidden mb-20" role="region" aria-labelledby="tab-title">
  <div class="px-6 py-4 bg-gray-800 border-b border-gray-700 flex justify-between items-center">
    <div>
      <%= link_to tabs_path, class: "text-gray-400 hover:text-white transition-colors duration-150", aria: { label: "Back to tabs" } do %>
        <svg class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
        </svg>
      <% end %>
    </div>
    <h2 id="tab-title" class="text-xl font-bold text-white text-center flex-grow-1"><%= tab.title %></h2>
    <div class="flex items-center space-x-4">
      <%= link_to edit_tab_path(tab), class: "text-gray-400 hover:text-white transition-colors duration-150", aria: { label: "Edit tab #{tab.title}" } do %>
        <svg class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10" />
        </svg>
      <% end %>
      <%= link_to "#", class: "text-red-500 hover:text-red-400 transition-colors duration-150", data: { bs_toggle: "modal", bs_target: "#confirmationModal", bs_tab_id: tab.id }, aria: { label: "Delete tab #{tab.title}" } do %>
        <svg class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.134-2.033-2.134H8.033C6.91 2.75 6 3.704 6 4.884v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
        </svg>
      <% end %>
    </div>
  </div>
  <div class="p-6 prose dark:prose-invert max-w-none">
    <%= tab.content %>
  </div>
</div>

<%= render 'shared/modal', title: 'Confirm Delete', body: 'Are you sure you want to proceed?', yes: 'Delete', no: 'Cancel', no_btn: 'bg-gray-600 hover:bg-gray-700 text-white font-bold py-2 px-4 rounded', yes_btn: 'bg-red-600 hover:bg-red-700 text-white font-bold py-2 px-4 rounded', devise_action: false, modal_id: 'confirmationModal' %>
