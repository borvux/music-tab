<div class="bg-gray-800 shadow-lg rounded-lg" role="region" aria-labelledby="create-tab-header">
  <div class="px-6 py-4 bg-gray-800 border-b border-gray-700 flex items-center">
    <%= link_to tabs_path, class: "text-gray-400 hover:text-white mr-4", aria: { label: "Back to tabs" } do %>
       <svg class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
      </svg>
    <% end %>
    <h2 id="create-tab-header" class="text-xl font-bold text-white">Create a New Tab</h2>
  </div>
  <div class="p-6">
    <%= render "form", tab: tab, button_label: "Create Tab" %>
  </div>
</div>
