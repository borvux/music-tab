<div class="py-16 bg-gray-900" role="region" aria-labelledby="navigate-music-tabs-title">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h2 id="navigate-music-tabs-title" class="text-3xl font-extrabold text-white">How to Navigate Music Tabs</h2>
    <p class="mt-4 text-lg text-gray-400">A quick look at how easy it is to manage your tabs.</p>
    
    <div class="mt-16 space-y-20">
      
      <!-- Feature 1: View All Tabs -->
      <div>
        <div class="max-w-2xl mx-auto text-center">
          <h3 class="text-2xl font-bold text-white mb-2">View All Tabs</h3>
          <p class="text-gray-400 mb-6">The list view shows all your tabs. You can click on any tab to view or edit it, and the plus button lets you add new ones.</p>
        </div>
        <div class="mt-4">
          <img src="<%= asset_path 'viewTabs.gif' %>" alt="Animated demonstration of the index view showing all tabs" class="rounded-lg shadow-2xl mx-auto border-2 border-gray-700">
        </div>
      </div>

      <!-- Feature 2: Create a Tab -->
      <div>
        <div class="max-w-2xl mx-auto text-center">
          <h3 class="text-2xl font-bold text-white mb-2">Create a Tab</h3>
          <p class="text-gray-400 mb-6">Create a new tab by entering a title and content. The editor supports rich text formatting. Just click "Create" to save.</p>
        </div>
        <div class="mt-4">
          <img src="<%= asset_path 'createTab.gif' %>" alt="Animated demonstration of creating a new tab" class="rounded-lg shadow-2xl mx-auto border-2 border-gray-700">
        </div>
      </div>

      <!-- Feature 3: View a Tab -->
      <div>
        <div class="max-w-2xl mx-auto text-center">
          <h3 class="text-2xl font-bold text-white mb-2">View a Tab</h3>
          <p class="text-gray-400 mb-6">View the full content of any tab you've created. All the formatted details are displayed for easy reading during practice.</p>
        </div>
        <div class="mt-4">
          <img src="<%= asset_path 'viewTab.gif' %>" alt="Animated demonstration of viewing a tab's full content" class="rounded-lg shadow-2xl mx-auto border-2 border-gray-700">
        </div>
      </div>

      <!-- Feature 4: Edit a Tab -->
      <div>
        <div class="max-w-2xl mx-auto text-center">
          <h3 class="text-2xl font-bold text-white mb-2">Edit a Tab</h3>
          <p class="text-gray-400 mb-6">You can easily edit the title and content of an existing tab. Save your changes when you're done.</p>
        </div>
        <div class="mt-4">
          <img src="<%= asset_path 'editTab.gif' %>" alt="Animated demonstration of editing an existing tab" class="rounded-lg shadow-2xl mx-auto border-2 border-gray-700">
        </div>
      </div>

    </div>
  </div>
</div>

