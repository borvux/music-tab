<div class="bg-gray-800 shadow-lg rounded-lg overflow-hidden" role="region" aria-labelledby="tabs-header">
  <div class="px-6 py-4 bg-gray-800 border-b border-gray-700 flex justify-between items-center">
    <h2 id="tabs-header" class="text-xl font-bold text-white">Your Tabs</h2>
    <%= link_to new_tab_path, class: "inline-flex items-center justify-center w-10 h-10 bg-sky-500 hover:bg-sky-600 text-white font-bold rounded-full transition-colors duration-150", aria: { label: "Create a new tab" } do %>
      <svg class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
      </svg>
    <% end %>
  </div>
  <div class="p-4" id="tabs">
    <%= render 'tabs_list', tabs: tabs %>
  </div>
</div>
